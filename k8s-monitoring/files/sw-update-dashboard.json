    {
      "id": 25,
      "type": "table",
      "title": "Latest result per suite",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
